'use client';

import React, { useState, useRef, useEffect } from 'react';
import { Send, Trash2 } from 'lucide-react';
import ReactMarkdown from 'react-markdown';
// Eliminado prism-react-renderer para evitar error de build
import { useLogs } from '@/context/LogContext';
import { sendMessage, ChatMessage } from '@/app/actions/chat';
import { Button } from '@/components/ui/button';
import {
  Dialog,
  DialogTrigger,
  DialogContent,
  DialogHeader,
  DialogFooter,
  DialogTitle,
  DialogDescription,
} from '@/components/ui/dialog';
import { Input } from '@/components/ui/input';
import { ScrollArea } from '@/components/ui/scroll-area';

interface ChatInterfaceProps {
  renderHeaderControls?: (props: {
    shareContext: boolean;
    setShareContext: (value: boolean) => void;
    showSharingModal: boolean;
    setShowSharingModal: (value: boolean) => void;
    selectedCount: number;
    shareFullData: boolean;
    handleClearHistory: () => void;
    messagesCount: number;
    modalShareSales: boolean;
    setModalShareSales: (value: boolean) => void;
    modalSharePlan: boolean;
    setModalSharePlan: (value: boolean) => void;
    modalShareConstraints: boolean;
    setModalShareConstraints: (value: boolean) => void;
    modalShareEmployees: boolean;
    setModalShareEmployees: (value: boolean) => void;
    modalShareMaintenance: boolean;
    setModalShareMaintenance: (value: boolean) => void;
    modalShareAbsenteeism: boolean;
    setModalShareAbsenteeism: (value: boolean) => void;
    modalShareWorkShifts: boolean;
    setModalShareWorkShifts: (value: boolean) => void;
    modalShareTactical: boolean;
    setModalShareTactical: (value: boolean) => void;
    modalShareFullData: boolean;
    setModalShareFullData: (value: boolean) => void;
    shareSales: boolean;
    sharePlan: boolean;
    shareConstraints: boolean;
    shareEmployees: boolean;
    shareMaintenance: boolean;
    shareAbsenteeism: boolean;
    shareWorkShifts: boolean;
    shareTactical: boolean;
    salesData: any;
    productionPlan: any;
    constraints: any;
    employees: any;
    maintenanceEvents: any;
    absenteeismEvents: any;
    workShifts: any;
    tacticalPlanResult: any;
    setShareSales: (value: boolean) => void;
    setSharePlan: (value: boolean) => void;
    setShareConstraints: (value: boolean) => void;
    setShareEmployees: (value: boolean) => void;
    setShareMaintenance: (value: boolean) => void;
    setShareAbsenteeism: (value: boolean) => void;
    setShareWorkShifts: (value: boolean) => void;
    setShareTactical: (value: boolean) => void;
    setShareFullData: (value: boolean) => void;
  }) => React.ReactNode;
}

export default function ChatInterface({ renderHeaderControls }: ChatInterfaceProps = {}) {
  const { logs } = useLogs();
  const appContext = require('@/context/AppProvider');
  const ctx = appContext.useAppContext();
  const {
    salesData,
    productionPlan,
    constraints,
    syncStatus,
    planningProgress,
    employees,
    maintenanceEvents,
    absenteeismEvents,
    workShifts,
    tacticalPlanResult
  } = ctx;
  // Clave para localStorage
  const CHAT_HISTORY_KEY = 'production_assistant_chat_history';
  
  // Cargar historial desde localStorage al montar el componente
  const loadMessagesFromStorage = (): ChatMessage[] => {
    if (typeof window === 'undefined') return [{ role: 'model', content: 'Hello! I am your Production Assistant. How can I help you today?' }];
    
    try {
      const stored = localStorage.getItem(CHAT_HISTORY_KEY);
      if (stored) {
        const parsed = JSON.parse(stored);
        // Validar que sea un array válido
        if (Array.isArray(parsed) && parsed.length > 0) {
          return parsed;
        }
      }
    } catch (error) {
      console.error('Error loading chat history from localStorage:', error);
    }
    
    // Retornar mensaje inicial si no hay historial guardado
    return [{ role: 'model', content: 'Hello! I am your Production Assistant. How can I help you today?' }];
  };

  const [messages, setMessages] = useState<ChatMessage[]>(loadMessagesFromStorage);
  const [input, setInput] = useState('');
  const [isLoading, setIsLoading] = useState(false);
  const [shareContext, setShareContext] = useState(true);
  const [shareFullData, setShareFullData] = useState(false);
  const [shareSales, setShareSales] = useState(true);
  const [sharePlan, setSharePlan] = useState(true);
  const [shareConstraints, setShareConstraints] = useState(false);
  const [shareEmployees, setShareEmployees] = useState(false);
  const [shareMaintenance, setShareMaintenance] = useState(false);
  const [shareAbsenteeism, setShareAbsenteeism] = useState(false);
  const [shareWorkShifts, setShareWorkShifts] = useState(false);
  const [shareTactical, setShareTactical] = useState(false);
  const [showSharingModal, setShowSharingModal] = useState(false);
  // Modal-local copies so Cancel can revert (changes are applied only on Save)
  const [modalShareSales, setModalShareSales] = useState(shareSales);
  const [modalSharePlan, setModalSharePlan] = useState(sharePlan);
  const [modalShareConstraints, setModalShareConstraints] = useState(shareConstraints);
  const [modalShareEmployees, setModalShareEmployees] = useState(shareEmployees);
  const [modalShareMaintenance, setModalShareMaintenance] = useState(shareMaintenance);
  const [modalShareAbsenteeism, setModalShareAbsenteeism] = useState(shareAbsenteeism);
  const [modalShareWorkShifts, setModalShareWorkShifts] = useState(shareWorkShifts);
  const [modalShareTactical, setModalShareTactical] = useState(shareTactical);
  const [modalShareFullData, setModalShareFullData] = useState(shareFullData);

  // When the modal opens, initialize modal-local copies from the current main toggles
  useEffect(() => {
    if (showSharingModal) {
      setModalShareSales(shareSales);
      setModalSharePlan(sharePlan);
      setModalShareConstraints(shareConstraints);
      setModalShareEmployees(shareEmployees);
      setModalShareMaintenance(shareMaintenance);
      setModalShareAbsenteeism(shareAbsenteeism);
      setModalShareWorkShifts(shareWorkShifts);
      setModalShareTactical(shareTactical);
      setModalShareFullData(shareFullData);
    }
  }, [showSharingModal]);

  const selectedCount = [shareSales, sharePlan, shareConstraints, shareEmployees, shareMaintenance, shareAbsenteeism, shareWorkShifts, shareTactical].filter(Boolean).length;
  const scrollRef = useRef<HTMLDivElement>(null);

  // Guardar mensajes en localStorage cada vez que cambien
  useEffect(() => {
    if (typeof window !== 'undefined') {
      try {
        localStorage.setItem(CHAT_HISTORY_KEY, JSON.stringify(messages));
      } catch (error) {
        console.error('Error saving chat history to localStorage:', error);
      }
    }
  }, [messages]);

  useEffect(() => {
    if (scrollRef.current) {
      scrollRef.current.scrollIntoView({ behavior: 'smooth' });
    }
  }, [messages]);

  const handleSend = async () => {
    if (!input.trim() || isLoading) return;

    const userMessage: ChatMessage = { role: 'user', content: input };
    setMessages(prev => [...prev, userMessage]);
    setInput('');
    setIsLoading(true);

    try {
      // Contexto enriquecido para el modelo
      const recentLogs = logs.slice(-50);
      const contextData: any = {};
      if (shareSales) {
        contextData.salesDataSample = salesData?.slice(0, 10);
        if (shareFullData) contextData.salesDataFull = salesData?.slice(0, Math.min(salesData?.length || 0, 500));
      }
      if (sharePlan) {
        contextData.productionPlanSample = productionPlan?.monthlyPlan?.slice(0, 10);
        if (shareFullData) contextData.productionPlanFull = productionPlan?.monthlyPlan?.slice(0, Math.min(productionPlan?.monthlyPlan?.length || 0, 500));
      }
      if (shareEmployees) {
        contextData.employeesSample = employees?.slice?.(0, 5);
        if (shareFullData) contextData.employeesFull = employees?.slice?.(0, Math.min(employees?.length || 0, 500));
      }
      if (shareMaintenance) {
        contextData.maintenanceSample = maintenanceEvents?.slice?.(0, 5);
        if (shareFullData) contextData.maintenanceFull = maintenanceEvents?.slice?.(0, Math.min(maintenanceEvents?.length || 0, 500));
      }
      if (shareAbsenteeism) {
        contextData.absenteeismSample = absenteeismEvents?.slice?.(0, 5);
        if (shareFullData) contextData.absenteeismFull = absenteeismEvents?.slice?.(0, Math.min(absenteeismEvents?.length || 0, 500));
      }
      if (shareWorkShifts) {
        contextData.workShiftSample = workShifts?.slice?.(0, 5);
        if (shareFullData) contextData.workShiftsFull = workShifts?.slice?.(0, Math.min(workShifts?.length || 0, 500));
      }
      if (shareTactical) {
        contextData.tacticalPlanSample = tacticalPlanResult?.plan?.slice?.(0, 5);
        if (shareFullData) contextData.tacticalPlanFull = tacticalPlanResult?.plan?.slice?.(0, Math.min(tacticalPlanResult?.plan?.length || 0, 500));
      }
      if (shareConstraints) {
        contextData.constraintsSummary = {
          workCenters: constraints?.workCenters?.length,
          productionLines: constraints?.productionLines?.length,
          workstationDefinitions: constraints?.workstationDefinitions?.length
        };
      }
      // always include non-sensitive flags
      contextData.syncStatus = syncStatus;
      contextData.planningProgress = planningProgress;
      contextData.includeFull = shareFullData;
      if (shareFullData) {
        const MAX_ROWS = 500;
        contextData.salesDataFull = salesData?.slice(0, Math.min(salesData?.length || 0, MAX_ROWS));
        contextData.productionPlanFull = productionPlan?.monthlyPlan?.slice(0, Math.min(productionPlan?.monthlyPlan?.length || 0, MAX_ROWS));
        contextData.employeesFull = employees?.slice?.(0, Math.min(employees?.length || 0, MAX_ROWS));
        contextData.maintenanceFull = maintenanceEvents?.slice?.(0, Math.min(maintenanceEvents?.length || 0, MAX_ROWS));
        contextData.absenteeismFull = absenteeismEvents?.slice?.(0, Math.min(absenteeismEvents?.length || 0, MAX_ROWS));
        contextData.workShiftsFull = workShifts?.slice?.(0, Math.min(workShifts?.length || 0, MAX_ROWS));
      }
      const response = await sendMessage([...messages, userMessage], recentLogs, shareContext ? contextData : undefined);
      setMessages(prev => [...prev, { role: 'model', content: response.text }]);
    } catch (error) {
      setMessages(prev => [...prev, { role: 'model', content: 'Sorry, something went wrong.' }]);
    } finally {
      setIsLoading(false);
    }
  };

  const handleClearHistory = () => {
    if (typeof window !== 'undefined') {
      const confirmed = window.confirm('¿Estás seguro de que deseas limpiar todo el historial de conversación?');
      if (confirmed) {
        const initialMessage: ChatMessage[] = [{ role: 'model', content: 'Hello! I am your Production Assistant. How can I help you today?' }];
        setMessages(initialMessage);
        localStorage.removeItem(CHAT_HISTORY_KEY);
      }
    }
  };

  return (
    <div className="flex flex-col h-full">
      <ScrollArea className="flex-1 p-4">
        <div className="space-y-4">
          {messages.map((msg, index) => (
            <div
              key={index}
              className={`flex ${msg.role === 'user' ? 'justify-end' : 'justify-start'}`}
            >
              <div
                className={`max-w-[85%] rounded-lg p-3 ${
                  msg.role === 'user'
                    ? 'bg-primary text-primary-foreground'
                    : 'bg-muted'
                }`}
              >
                <div className="prose prose-sm dark:prose-invert">
                  <ReactMarkdown
                    components={{
                      p({node, children, ...props}: any) {
                        // Render paragraphs as divs to avoid block inside <p> hydration errors
                        return <div {...props}>{children}</div>;
                      },
                      code({node, inline, className, children, ...props}: any) {
                        // Fallback: render code blocks with styled <pre><code>
                        if (!inline) {
                          return (
                            <div style={{ margin: '8px 0' }}>
                              <pre
                                className={className}
                                style={{
                                  background: '#f6f8fa',
                                  color: '#222',
                                  borderRadius: 8,
                                  padding: '12px 16px',
                                  fontSize: 14,
                                  fontFamily: 'JetBrains Mono, monospace',
                                  overflowX: 'auto',
                                  boxShadow: '0 2px 8px rgba(0,0,0,0.04)'
                                }}
                              >
                                <code>{children}</code>
                              </pre>
                            </div>
                          );
                        }
                        return (
                          <code className={className} style={{ background: '#f6f8fa', borderRadius: 4, padding: '2px 6px', fontSize: 13 }}>{children}</code>
                        );
                      }
                    }}
                  >
                    {msg.content}
                  </ReactMarkdown>
                </div>
              </div>
            </div>
          ))}
          {isLoading && (
            <div className="flex justify-start">
              <div className="bg-muted rounded-lg p-3">
                <span className="animate-pulse">Thinking...</span>
              </div>
            </div>
          )}
          <div ref={scrollRef} />
        </div>
      </ScrollArea>
      
      {/* Render header controls in parent if callback provided */}
      {renderHeaderControls && renderHeaderControls({
        shareContext,
        setShareContext,
        showSharingModal,
        setShowSharingModal,
        selectedCount,
        shareFullData,
        handleClearHistory,
        messagesCount: messages.length,
        modalShareSales,
        setModalShareSales,
        modalSharePlan,
        setModalSharePlan,
        modalShareConstraints,
        setModalShareConstraints,
        modalShareEmployees,
        setModalShareEmployees,
        modalShareMaintenance,
        setModalShareMaintenance,
        modalShareAbsenteeism,
        setModalShareAbsenteeism,
        modalShareWorkShifts,
        setModalShareWorkShifts,
        modalShareTactical,
        setModalShareTactical,
        modalShareFullData,
        setModalShareFullData,
        shareSales,
        sharePlan,
        shareConstraints,
        shareEmployees,
        shareMaintenance,
        shareAbsenteeism,
        shareWorkShifts,
        shareTactical,
        salesData,
        productionPlan,
        constraints,
        employees,
        maintenanceEvents,
        absenteeismEvents,
        workShifts,
        tacticalPlanResult,
        setShareSales,
        setSharePlan,
        setShareConstraints,
        setShareEmployees,
    const userMessage: ChatMessage = { role: 'user', content: input };
    setMessages(prev => [...prev, userMessage]);
    setInput('');
    setIsLoading(true);

    try {
      // Contexto enriquecido para el modelo
      const recentLogs = logs.slice(-50);
      const contextData: any = {};
      if (shareSales) {
        contextData.salesDataSample = salesData?.slice(0, 10);
        if (shareFullData) contextData.salesDataFull = salesData?.slice(0, Math.min(salesData?.length || 0, 500));
      }
      if (sharePlan) {
        contextData.productionPlanSample = productionPlan?.monthlyPlan?.slice(0, 10);
        if (shareFullData) contextData.productionPlanFull = productionPlan?.monthlyPlan?.slice(0, Math.min(productionPlan?.monthlyPlan?.length || 0, 500));
      }
      if (shareEmployees) {
        contextData.employeesSample = employees?.slice?.(0, 5);
        if (shareFullData) contextData.employeesFull = employees?.slice?.(0, Math.min(employees?.length || 0, 500));
      }
      if (shareMaintenance) {
        contextData.maintenanceSample = maintenanceEvents?.slice?.(0, 5);
        if (shareFullData) contextData.maintenanceFull = maintenanceEvents?.slice?.(0, Math.min(maintenanceEvents?.length || 0, 500));
      }
      if (shareAbsenteeism) {
        contextData.absenteeismSample = absenteeismEvents?.slice?.(0, 5);
        if (shareFullData) contextData.absenteeismFull = absenteeismEvents?.slice?.(0, Math.min(absenteeismEvents?.length || 0, 500));
      }
      if (shareWorkShifts) {
        contextData.workShiftSample = workShifts?.slice?.(0, 5);
        if (shareFullData) contextData.workShiftsFull = workShifts?.slice?.(0, Math.min(workShifts?.length || 0, 500));
      }
      if (shareTactical) {
        contextData.tacticalPlanSample = tacticalPlanResult?.plan?.slice?.(0, 5);
        if (shareFullData) contextData.tacticalPlanFull = tacticalPlanResult?.plan?.slice?.(0, Math.min(tacticalPlanResult?.plan?.length || 0, 500));
      }
      if (shareConstraints) {
        contextData.constraintsSummary = {
          workCenters: constraints?.workCenters?.length,
          productionLines: constraints?.productionLines?.length,
          workstationDefinitions: constraints?.workstationDefinitions?.length
        };
      }
      // always include non-sensitive flags
      contextData.syncStatus = syncStatus;
      contextData.planningProgress = planningProgress;
      contextData.includeFull = shareFullData;
      if (shareFullData) {
        const MAX_ROWS = 500;
        contextData.salesDataFull = salesData?.slice(0, Math.min(salesData?.length || 0, MAX_ROWS));
        contextData.productionPlanFull = productionPlan?.monthlyPlan?.slice(0, Math.min(productionPlan?.monthlyPlan?.length || 0, MAX_ROWS));
        contextData.employeesFull = employees?.slice?.(0, Math.min(employees?.length || 0, MAX_ROWS));
        contextData.maintenanceFull = maintenanceEvents?.slice?.(0, Math.min(maintenanceEvents?.length || 0, MAX_ROWS));
        contextData.absenteeismFull = absenteeismEvents?.slice?.(0, Math.min(absenteeismEvents?.length || 0, MAX_ROWS));
        contextData.workShiftsFull = workShifts?.slice?.(0, Math.min(workShifts?.length || 0, MAX_ROWS));
      }
      const response = await sendMessage([...messages, userMessage], recentLogs, shareContext ? contextData : undefined);
      setMessages(prev => [...prev, { role: 'model', content: response.text }]);
    } catch (error) {
      setMessages(prev => [...prev, { role: 'model', content: 'Sorry, something went wrong.' }]);
    } finally {
      setIsLoading(false);
    }
  };

  const handleClearHistory = () => {
    if (typeof window !== 'undefined') {
      const confirmed = window.confirm('¿Estás seguro de que deseas limpiar todo el historial de conversación?');
      if (confirmed) {
        const initialMessage: ChatMessage[] = [{ role: 'model', content: 'Hello! I am your Production Assistant. How can I help you today?' }];
        setMessages(initialMessage);
        localStorage.removeItem(CHAT_HISTORY_KEY);
      }
    }
  };

  return (
    <div className="flex flex-col h-full">
      <ScrollArea className="flex-1 p-4">
        <div className="space-y-4">
          {messages.map((msg, index) => (
            <div
              key={index}
              className={`flex ${msg.role === 'user' ? 'justify-end' : 'justify-start'}`}
            >
              <div
                className={`max-w-[85%] rounded-lg p-3 ${
                  msg.role === 'user'
                    ? 'bg-primary text-primary-foreground'
                    : 'bg-muted'
                }`}
              >
                <div className="prose prose-sm dark:prose-invert">
                  <ReactMarkdown
                    components={{
                      p({node, children, ...props}: any) {
                        // Render paragraphs as divs to avoid block inside <p> hydration errors
                        return <div {...props}>{children}</div>;
                      },
                      code({node, inline, className, children, ...props}: any) {
                        // Fallback: render code blocks with styled <pre>codes
                        if (!inline) {
                          return (
                            <div style={{ margin: '8px 0' }}>
                              <pre
                                className={className}
                                style={{
                                  background: '#f6f8fa',
                                  color: '#222',
                                  borderRadius: 8,
                                  padding: '12px 16px',
                                  fontSize: 14,
                                  fontFamily: 'JetBrains Mono, monospace',
                                  overflowX: 'auto',
                                  boxShadow: '0 2px 8px rgba(0,0,0,0.04)'
                                }}
                              >
                                <code>{children}</code>
                              </pre>
                            </div>
                          );
                        }
                        return (
                          <code className={className} style={{ background: '#f6f8fa', borderRadius: 4, padding: '2px 6px', fontSize: 13 }}>{children}</code>
                        );
                      }
                    }}
                  >
                    {msg.content}
                  </ReactMarkdown>
                </div>
              </div>
            </div>
          ))}
          {isLoading && (
            <div className="flex justify-start">
              <div className="bg-muted rounded-lg p-3">
                <span className="animate-pulse">Thinking...</span>
              </div>
            </div>
          )}
          <div ref={scrollRef} />
        </div>
      </ScrollArea>
      
      {/* Render header controls in parent if callback provided */}
      {renderHeaderControls && renderHeaderControls({
        shareContext,
        setShareContext,
        showSharingModal,
        setShowSharingModal,
        selectedCount,
        shareFullData,
        handleClearHistory,
        messagesCount: messages.length,
        modalShareSales,
        setModalShareSales,
        modalSharePlan,
        setModalSharePlan,
        modalShareConstraints,
        setModalShareConstraints,
        modalShareEmployees,
        setModalShareEmployees,
        modalShareMaintenance,
        setModalShareMaintenance,
        modalShareAbsenteeism,
        setModalShareAbsenteeism,
        modalShareWorkShifts,
        setModalShareWorkShifts,
        modalShareTactical,
        setModalShareTactical,
        modalShareFullData,
        setModalShareFullData,
        shareSales,
        sharePlan,
        shareConstraints,
        shareEmployees,
        shareMaintenance,
        shareAbsenteeism,
        shareWorkShifts,
        shareTactical,
        salesData,
        productionPlan,
        constraints,
        employees,
        maintenanceEvents,
        absenteeismEvents,
        workShifts,
        tacticalPlanResult,
        setShareSales,
        setSharePlan,
        setShareConstraints,
        setShareEmployees,
        setShareMaintenance,
        setShareAbsenteeism,
        setShareWorkShifts,
        setShareTactical,
        setShareFullData,
      })}

      <div className="p-4 border-t">
        <form
          onSubmit={(e) => {
            e.preventDefault();
            handleSend();
          }}
          className="flex gap-2"
        >
          <Input
            value={input}
            onChange={(e) => setInput(e.target.value)}
            placeholder="Ask about the system status..."
            disabled={isLoading}
            className="flex-1"
          />
          <Button type="submit" size="icon" disabled={isLoading}>
            <Send className="h-4 w-4" />
          </Button>
        </form>
      </div>

      {/* Dialog modal definition (rendered invisibly, controlled by state) */}
      <Dialog open={showSharingModal} onOpenChange={open => setShowSharingModal(open)}>
        <DialogContent>
          <DialogHeader>
            <DialogTitle>Configure shared data</DialogTitle>
            <DialogDescription>Choose which data the assistant may use for better answers. Click Save to apply changes.</DialogDescription>
          </DialogHeader>
          <div className="mt-2 grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-2 text-sm">
            <label className="inline-flex items-center"><input type="checkbox" checked={modalShareSales} onChange={e => setModalShareSales(e.target.checked)} className="mr-2" />Share Sales <span className="ml-1 text-gray-400">({salesData?.length || 0})</span></label>
            <label className="inline-flex items-center"><input type="checkbox" checked={modalSharePlan} onChange={e => setModalSharePlan(e.target.checked)} className="mr-2" />Share Plan <span className="ml-1 text-gray-400">({productionPlan?.monthlyPlan?.length || 0})</span></label>
            <label className="inline-flex items-center"><input type="checkbox" checked={modalShareConstraints} onChange={e => setModalShareConstraints(e.target.checked)} className="mr-2" />Share Constraints <span className="ml-1 text-gray-400">({constraints?.workCenters?.length || 0} wCenters)</span></label>
            <label className="inline-flex items-center"><input type="checkbox" checked={modalShareEmployees} onChange={e => setModalShareEmployees(e.target.checked)} className="mr-2" />Share Employees <span className="ml-1 text-gray-400">({employees?.length || 0})</span></label>
            <label className="inline-flex items-center"><input type="checkbox" checked={modalShareMaintenance} onChange={e => setModalShareMaintenance(e.target.checked)} className="mr-2" />Share Maintenance <span className="ml-1 text-gray-400">({maintenanceEvents?.length || 0})</span></label>
            <label className="inline-flex items-center"><input type="checkbox" checked={modalShareAbsenteeism} onChange={e => setModalShareAbsenteeism(e.target.checked)} className="mr-2" />Share Absentees <span className="ml-1 text-gray-400">({absenteeismEvents?.length || 0})</span></label>
            <label className="inline-flex items-center"><input type="checkbox" checked={modalShareWorkShifts} onChange={e => setModalShareWorkShifts(e.target.checked)} className="mr-2" />Share WorkShifts <span className="ml-1 text-gray-400">({workShifts?.length || 0})</span></label>
            <label className="inline-flex items-center"><input type="checkbox" checked={modalShareTactical} onChange={e => setModalShareTactical(e.target.checked)} className="mr-2" />Share Tactical <span className="ml-1 text-gray-400">({tacticalPlanResult?.plan?.length || 0})</span></label>
          </div>
          <div className="mt-4">
            <label className="inline-flex items-center text-sm"><input type="checkbox" checked={modalShareFullData} onChange={(e) => {
              if (e.target.checked) {
                const ok = typeof window !== 'undefined' ? window.confirm('Sharing full data may expose sensitive information. Do you want to proceed?') : true;
                if (ok) setModalShareFullData(true);
              } else {
                setModalShareFullData(false);
              }
            }} className="mr-2" />
            <span>Include full data (may include PII)</span></label>
            {modalShareFullData && (
              <div className="text-xs text-red-600 mt-1">Warning: sharing full data may expose sensitive information. Ensure consent and compliance.</div>
            )}
          </div>
          <DialogFooter className="mt-4">
            <Button variant="ghost" onClick={() => {
              // Reset modal values to the current main states and close
              setModalShareSales(shareSales);
              setModalSharePlan(sharePlan);
              setModalShareConstraints(shareConstraints);
              setModalShareEmployees(shareEmployees);
              setModalShareMaintenance(shareMaintenance);
              setModalShareAbsenteeism(shareAbsenteeism);
              setModalShareWorkShifts(shareWorkShifts);
              setModalShareTactical(shareTactical);
              setModalShareFullData(shareFullData);
              setShowSharingModal(false);
            }}>Cancel</Button>
            <Button onClick={() => {
              // Apply modal values to the main toggles
              setShareSales(modalShareSales);
              setSharePlan(modalSharePlan);
              setShareConstraints(modalShareConstraints);
              setShareEmployees(modalShareEmployees);
              setShareMaintenance(modalShareMaintenance);
              setShareAbsenteeism(modalShareAbsenteeism);
              setShareWorkShifts(modalShareWorkShifts);
              setShareTactical(modalShareTactical);
              setShareFullData(modalShareFullData);
              setShowSharingModal(false);
            }}>Save</Button>
          </DialogFooter>
        </DialogContent>
      </Dialog>
    </div>
  );
}
